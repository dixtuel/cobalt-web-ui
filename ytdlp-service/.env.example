# Downloader ytdlp-service — Örnek Ortam Değişkenleri
# Gerçek değerlerle doldurup .env olarak kaydedin (chmod 600).

# Gunicorn / Flask dinleme portu (varsayılan 5000)
PORT=5000

# İsteğe bağlı: YouTube cookies.txt dosyasının konteyner içi yolu
# Host üzerinde ./cookies/cookies.txt altına yerleştirildiğinde /app/cookies/cookies.txt olarak bağlanır.
YTDLP_COOKIES_FILE=/app/cookies/cookies.txt
# Veya doğrudan çerez metni buraya yapıştırılabilir:
YTDLP_COOKIES_TEXT=

# İsteğe bağlı: Reddit API kimlik bilgileri (Reddit bot koruması / 403 aşımı için)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# POT Provider (Proof of Origin token servisi)
POT_PROVIDER_URL=http://pot-provider:4416

# Deno Deploy Egress Rölesi (İsteğe bağlı)
DENO_RELAY_URL=https://your-relay.deno.net
DENO_RELAY_SECRET=your-secure-shared-secret
DENO_MONTHLY_LIMIT=900000

# AWS Lambda Egress Rölesi (İsteğe bağlı)
LAMBDA_RELAY_URL=https://your-lambda-url.on.aws
LAMBDA_RELAY_SECRET=your-secure-shared-secret
LAMBDA_MONTHLY_LIMIT=900000

# Güvenlik & Hız Limiti (IP başına dakikalık istek sınırı)
RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW_MS=60000
