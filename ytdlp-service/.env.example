# Egress relé (isteğe bağlı, en az biri). Boş bırakılırsa tüm YouTube
# çözümleme istekleri doğrudan sunucunuzun kendi IP'sinden gider — relé
# kurmak zorunlu değil, sistem onsuz da çalışır. İkisi de doluysa yük
# aralarında bölünür (bkz. adapter.py).
#
# Not: Deno Deploy ve AWS Lambda ham CONNECT tünellemesini desteklemiyor —
# `adapter.py` (mitmproxy, yalnız 127.0.0.1'de) yt-dlp'ye gerçek bir proxy
# gibi görünüp trafiği bu relé'lere header-tabanlı iletir. Kendi relé'nizi
# deploy etmek için bkz. deno-relay/main.ts + README.md.
DENO_RELAY_URL=
DENO_RELAY_SECRET=
LAMBDA_RELAY_URL=
LAMBDA_RELAY_SECRET=

# İsteğe bağlı: gerçek bir YouTube hesabının cookies.txt dosyasının konteyner
# içindeki yolu (bazı videolar için erişimi artırabilir).
YTDLP_COOKIES_FILE=

# IP başına dakikalık istek sınırı (varsayılan 10).
RATE_LIMIT_MAX=10
