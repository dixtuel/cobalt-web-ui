# Deno Deploy egress relé (isteğe bağlı). Boş bırakılırsa tüm YouTube
# çözümleme istekleri doğrudan sunucunuzun kendi IP'sinden gider — relé
# kurmak zorunlu değil, sistem onsuz da çalışır.
#
# Kendi relé'nizi deploy etmek için bkz. deno-relay/main.ts + README.md.
DENO_RELAY_URL=
DENO_RELAY_SECRET=

# İsteğe bağlı: gerçek bir YouTube hesabının cookies.txt dosyasının konteyner
# içindeki yolu (bazı videolar için erişimi artırabilir).
YTDLP_COOKIES_FILE=

# IP başına dakikalık istek sınırı (varsayılan 10).
RATE_LIMIT_MAX=10
